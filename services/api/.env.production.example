# Production image provider. Keep local model paths out of production config.
IMAGEGEN_PROVIDER=ark
ARK_API_KEY=replace-with-production-secret
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# The LLM provider is configured independently from image generation.
OPENAI_API_KEY=replace-with-production-secret
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
CODER_MODEL=deepseek-coder
