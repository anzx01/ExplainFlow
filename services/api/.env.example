# LLM 配置（使用 DeepSeek API，兼容 OpenAI SDK）
OPENAI_API_KEY=your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
CODER_MODEL=deepseek-coder
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_S=1.0
LLM_JSON_MAX_TOKENS=8192
LLM_JSON_PARSE_RETRIES=2

# CORS 配置（逗号分隔，支持生产环境部署）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 图像生成配置（火山引擎 Ark / Seedream 5.0）
IMAGEGEN_PROVIDER=comfyui
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=D:\\aiapp\\ExplainFlow\\config\\comfyui\\scene-image-api.json
COMFYUI_CHECKPOINT=meinaPastelV5_bakedVAE.safetensors
COMFYUI_LORA=
COMFYUI_LORA_STRENGTH=0.8
COMFYUI_LORA_TRIGGER=doodle, messy, stickfigure, crayola, crayons, colored chalk, scribble
COMFYUI_TIMEOUT_S=600
COMFYUI_STEPS=12
COMFYUI_CLIENT_ID=explainflow
LOCAL_IMAGEGEN_RUNTIME=D:\ck\04-第三方库与二进制依赖\stable-diffusion-cpp-bin\vulkan\sd-cli.exe
LOCAL_IMAGEGEN_MODEL=E:\MYLLM\flux1-schnell-fp8\gguf\flux1-schnell-Q5_K_S.gguf
LOCAL_IMAGEGEN_VAE=E:\MYLLM\flux1-schnell-fp8\extracted\vae\diffusion_pytorch_model.safetensors
LOCAL_IMAGEGEN_CLIP_L=E:\MYLLM\flux1-schnell-fp8\extracted\clip\clip-text-model.safetensors
LOCAL_IMAGEGEN_T5XXL=E:\MYLLM\flux1-schnell-fp8\extracted\t5\t5xxl-relative-q8_0.gguf
LOCAL_IMAGEGEN_BACKEND=diffusion=Vulkan0,te=cpu,vae=cpu
LOCAL_IMAGEGEN_OFFLOAD_TO_CPU=true
LOCAL_IMAGEGEN_DIFFUSION_FLASH_ATTENTION=true
LOCAL_IMAGEGEN_VAE_TILING=true
LOCAL_IMAGEGEN_VAE_TILE_SIZE=128x128
LOCAL_IMAGEGEN_WIDTH=1024
LOCAL_IMAGEGEN_HEIGHT=1024
LOCAL_IMAGEGEN_PREVIEW_WIDTH=512
LOCAL_IMAGEGEN_PREVIEW_HEIGHT=512
LOCAL_IMAGEGEN_STEPS=4
LOCAL_IMAGEGEN_GUIDANCE=3.5
LOCAL_IMAGEGEN_LORA_DIR=E:\MYLLM\loras
LOCAL_IMAGEGEN_LORA=
LOCAL_IMAGEGEN_LORA_STRENGTH=0.65
LOCAL_IMAGEGEN_LORA_TRIGGER=ChalkBoardDrawing
LOCAL_IMAGEGEN_FLUX_WIDTH=768
LOCAL_IMAGEGEN_FLUX_HEIGHT=768
LOCAL_IMAGEGEN_FLUX_PREVIEW_WIDTH=512
LOCAL_IMAGEGEN_FLUX_PREVIEW_HEIGHT=512
LOCAL_IMAGEGEN_MAX_ATTEMPTS=3
LOCAL_IMAGEGEN_TIMEOUT_S=600

# Optional Volcengine fallback. Set IMAGEGEN_PROVIDER=ark or local_then_ark.
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-260128

# TTS 配置（使用 edge-tts，免费无需 API key）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 服务配置
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
